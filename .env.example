SUPABASE_PROJECT_REF="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_DB_PASSWORD="your-database-password"
SUPABASE_DIRECT_URL="postgresql://postgres:your-database-password@db.your-project-ref.supabase.co:5432/postgres"
# Prefer Supabase's transaction pooler connection string on Vercel/serverless.
# DATABASE_URL="postgresql://postgres.your-project-ref:your-database-password@aws-0-region.pooler.supabase.com:6543/postgres"

# Use this for hosted Supabase-backed deployments.
# KOKOROE_STORE="supabase"

# Keep JSON or SQLite locally when not testing hosted persistence.
# KOKOROE_STORE="sqlite"

# Global message classification stays off unless explicitly enabled.
# KOKOROE_MESSAGE_CLASSIFIER="global-cloud"
# KOKOROE_CLASSIFIER_PROVIDER="openrouter"
# OPENROUTER_API_KEY="your-server-only-openrouter-key"
# KOKOROE_CLASSIFIER_MODEL="tencent/hy3:free"
# KOKOROE_CLASSIFIER_CONTEXT="recent-messages"
# Comma-separated room ids; no room is eligible when this is unset.
# KOKOROE_CLASSIFIER_CANARY_ROOMS="after-school"
# Use KOKOROE_CLASSIFIER_PROVIDER="gateway" with VERCEL_OIDC_TOKEN or
# AI_GATEWAY_API_KEY and a Gateway model id to retain the Gateway adapter.
# Use "discussion-compaction" only to add a separate model pass that segments
# up to 40 prior room messages into topic summaries before classification.
