{
  "version": 1,
  "voice": {
    "name": "Kokoroe story language",
    "principles": [
      "Use manga and story-world language for moments of identity, movement, and creation.",
      "Keep fields, permissions, errors, and irreversible actions literal enough to understand immediately.",
      "Give each operation its own fitting activity phrase instead of reusing a generic loading verb.",
      "Pair expressive action copy with a plain-language meaning and, when needed, an accessible label."
    ]
  },
  "entries": {
    "auth.login.eyebrow": {
      "surface": "authentication",
      "intent": "Introduce returning-account sign in",
      "plainMeaning": "Continue to sign in",
      "status": "approved",
      "variants": {
        "default": "Continue your story"
      }
    },
    "auth.login.title": {
      "surface": "authentication",
      "intent": "Welcome a returning account",
      "plainMeaning": "Welcome back",
      "status": "approved",
      "variants": {
        "default": "Turn the next page."
      }
    },
    "auth.login.body": {
      "surface": "authentication",
      "intent": "Explain what returns after sign in",
      "plainMeaning": "Your rooms, avatars, and conversations are ready",
      "status": "approved",
      "variants": {
        "default": "Return to the worlds, characters, and conversations you left between panels."
      }
    },
    "auth.create.eyebrow": {
