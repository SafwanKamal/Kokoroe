      }
    },
    "auth.create.submit": {
      "surface": "authentication",
      "intent": "Submit a new account",
      "plainMeaning": "Create account",
      "status": "approved",
      "ariaLabel": "Create a Kokoroe account",
      "variants": {
        "default": "Join the Cast →",
        "busy": "Inking your place…"
      }
    },
    "auth.switch.toCreate.prompt": {
      "surface": "authentication",
      "intent": "Introduce the account-creation switch",
      "plainMeaning": "New to Kokoroe?",
      "status": "approved",
      "variants": {
        "default": "No role in Kokoroe yet?"
      }
    },
    "auth.switch.toCreate.action": {
      "surface": "authentication",
      "intent": "Switch from sign in to account creation",
      "plainMeaning": "Create account",
      "status": "approved",
      "ariaLabel": "Create a Kokoroe account",
      "variants": {
        "default": "Join the cast"
      }
    },
